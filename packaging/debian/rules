#!/usr/bin/make -f
# The frontend is a Vite bundle and the backend is a cargo workspace; neither
# has a configure step debhelper could infer, so every stage is explicit and
# --buildsystem=none keeps dh from probing for one.
#
# CARGO_TARGET_DIR is redirected into debian/ so `dh_auto_clean` and
# dpkg-source -b never walk a target/ directory that cargo owns anyway.

# Pinned here as well as in CI so the bundle cannot be produced by a different
# pnpm than the one the lockfile was written against.
PNPM := npx --yes pnpm@10.32.1
TARGET := $(CURDIR)/debian/target

%:
	dh $@ --buildsystem=none

override_dh_auto_configure:

override_dh_auto_build:
	$(PNPM) install --frozen-lockfile
	$(PNPM) build
	cd src-tauri && CARGO_TARGET_DIR=$(TARGET) cargo build --locked --release --bin open-revo
	# The EC helper belongs to openrevo-core, so it needs its own -p: --bin alone
	# is scoped to the default-run package and aborts the build.
	cd src-tauri && CARGO_TARGET_DIR=$(TARGET) cargo build --locked --release -p openrevo-core --bin openrevo-ec-helper

override_dh_auto_test:

override_dh_auto_install:
	install -Dm755 $(TARGET)/release/open-revo debian/openrevo/usr/bin/open-revo
	install -Dm644 packaging/linux/openrevo.desktop debian/openrevo/usr/share/applications/open-revo.desktop
	for size in 32 64 128; do \
	  install -Dm644 src-tauri/icons/$${size}x$${size}.png \
	    debian/openrevo/usr/share/icons/hicolor/$${size}x$${size}/apps/open-revo.png; \
	done
	install -Dm644 src-tauri/icons/128x128@2x.png debian/openrevo/usr/share/icons/hicolor/256x256/apps/open-revo.png
	# udev rules, the ec_sys module parameter and the modules-load file are one
	# unit: the rule file alone leaves every bank-0 write silently failing.
	install -Dm644 packaging/linux/60-openrevo.rules debian/openrevo/usr/lib/udev/rules.d/60-openrevo.rules
	install -Dm644 packaging/linux/modprobe-openrevo.conf debian/openrevo/usr/lib/modprobe.d/openrevo.conf
	install -Dm644 packaging/linux/modules-load-openrevo.conf debian/openrevo/usr/lib/modules-load.d/openrevo.conf
	install -Dm644 packaging/linux/openrevo.service debian/openrevo/usr/lib/systemd/user/openrevo.service
	# Root EC broker. dh_installsystemd enables it and dh_installsysusers creates
	# the group; debian/openrevo.postinst then adds the users already on the box.
	install -Dm644 packaging/linux/openrevo-ec.service debian/openrevo/lib/systemd/system/openrevo-ec.service
	install -Dm644 packaging/linux/sysusers-openrevo.conf debian/openrevo/usr/lib/sysusers.d/openrevo.conf
	# Not setuid: pkexec plus the policy decides, and the policy pins this path.
	install -Dm755 $(TARGET)/release/openrevo-ec-helper debian/openrevo/usr/lib/openrevo/openrevo-ec-helper
	install -Dm644 packaging/linux/com.openrevo.ecwrite.policy debian/openrevo/usr/share/polkit-1/actions/com.openrevo.ecwrite.policy
	install -Dm644 LICENSE debian/openrevo/usr/share/doc/openrevo/LICENSE

override_dh_auto_clean:
	rm -rf debian/target dist

override_dh_strip:
	dh_strip --no-automatic-dbgsym
